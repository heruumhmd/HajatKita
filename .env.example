# ========================================================
# HAJAT KITA - ENVIRONMENT CONFIGURATION (.env.local)
# Slogan: Biar Nikah Lebih Terarah
# ========================================================

# 1. DATABASE (Neon Serverless PostgreSQL)
# Diambil dari Neon Console -> Connection Details -> Pooled Connection.
# Pastikan menyertakan '?sslmode=require'.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. AUTHENTICATION (Auth.js / NextAuth v5)
# AUTH_SECRET: Wajib diisi di production (minimal 32 karakter).
# Dilarang menggunakan nilai default. Aplikasi akan melempar Error fatal di production jika tidak diisi.
# Cara generate kunci aman:
#   openssl rand -base64 33
#   atau: npx auth secret
AUTH_SECRET="your-super-secret-random-key-at-least-32-chars-long"

# AUTH_URL / NEXT_PUBLIC_APP_URL:
# PENTING: Di production (Vercel), URL HARUS diawali dengan protokol "https://"
# Contoh production: "https://hajatkita.vercel.app"
# Jika diawali "http://", browser menolak cookie secure (__Host- prefix),
# menyebabkan sesi pengguna drop atau tidak sinkron antar tab dan perangkat.
# Di local development, gunakan "http://localhost:3000".
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Trust host header saat di-deploy di Vercel / proxy serverless
AUTH_TRUST_HOST="true"

# 3. GOOGLE OAUTH 2.0 CREDENTIALS (Google Cloud Console)
# Dibuat di https://console.cloud.google.com -> APIs & Services -> Credentials
# PENTING: Pada bagian "Authorized redirect URIs", tambahkan:
#   Development: http://localhost:3000/api/auth/callback/google
#   Production:  https://your-production-domain.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
# Alternatif nama env var standar:
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
